include launch.py distribution.json release-files.json requirements.txt
include LICENSE README.md CONTRIBUTING.md THIRD_PARTY.md RELEASE_NOTES.md
include README.en.md README.ja.md
include *.cmd *.ps1
recursive-include assets *.ico
recursive-include docs *.md
recursive-include tools *.py
recursive-include tests *.py *.js
recursive-exclude * __pycache__ *.py[cod]
prune generated
prune .local
prune debug
prune .venv
